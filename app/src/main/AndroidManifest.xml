<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Installed from an APK rather than a store, so the app has to be able to offer its own
      updates: this is what lets it install a downloaded release. It grants nothing beyond
      that — Android still refuses an APK signed with a different key, which is what makes
      it safe.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets an update install without Android's confirmation screen; see Updater.installSession. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!--
      Android Auto. MAP_TEMPLATES buys MapWithContentTemplate, which is the one template outside the
      navigation category that lets an app draw the screen itself rather than filling in rows;
      ACCESS_SURFACE is what actually hands over the canvas. Both are declarations rather than
      prompts — the host grants them by reading this file.

      Drawing the lyrics on a surface meant for a map is a liberty, and taken deliberately: it is the
      only way a car screen can show the same words moving the same way the phone does, which is the
      whole point of the feature. See docs/ANDROID-AUTO.md.
    -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <!--
      Android 11+ hides other installed apps from us. We do not need to *launch* other
      apps to work — the media session is enough — but we do want to name the player in
      the UI and offer to open it, so declare an interest in the two things a music app
      publishes. Deliberately not QUERY_ALL_PACKAGES: it is far more access than naming
      a player warrants, and the fallback reads fine without it.
    -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
    </queries>

    <application
        android:name=".MelismaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Melisma"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <!--
          Android Auto. The descriptor is what makes the host look at this app at all; the API level
          is the oldest car host this build will talk to, and the theme gives the host the app's own
          colours for the chrome it draws itself. See docs/ANDROID-AUTO.md for what a car screen
          shows and, more to the point, what it deliberately does not.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
        <meta-data
            android:name="androidx.car.app.theme"
            android:resource="@style/CarAppTheme" />

        <!--
          supportsPictureInPicture + resizeableActivity are what let the lyrics carry on
          in a floating window when you leave the app. configChanges has to cover
          screenSize and smallestScreenSize or the activity is recreated on the way into
          the window, which would restart the animation and lose the scroll position.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Melisma">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets the user open a .lrc / .ttml / .lrcx file straight into the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          The whole point of this service is the permission it declares: once the
          user grants "notification access", the system lets us call
          MediaSessionManager.getActiveSessions(), which is how we see what is
          playing in Spotify (or any other player) and where its playhead is.
        -->
        <service
            android:name=".media.MediaNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!--
          The car screen.
          Exported because the Android Auto host is a different process and has to be able to bind
          it; `createHostValidator` is what decides who may, which is the check that stands in for a
          permission here.

          The category is a compromise stated plainly: the Car App Library has seven, none of them
          for lyrics. POI is the one that can reach MapWithContentTemplate, which is what gives the
          app a surface of its own to draw the lyrics on — so the category is chosen for the template
          it unlocks rather than for describing the app. The consequence is that this can never be a
          Play-listed Android Auto app and needs Android Auto's own unknown-sources developer setting
          to appear, which is the same audience an APK already has.
        -->
        <service
            android:name=".car.MelismaCarAppService"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

        <!-- An update's install status, from Android; see InstallStatusReceiver. -->
        <receiver
            android:name=".update.InstallStatusReceiver"
            android:exported="false" />

        <!--
          Hands the downloaded APK to the system installer's screen, when an install session
          cannot be started. A content URI rather than a
          file path, because passing a file:// URI across processes has been forbidden
          since Android 7 — and this way the read permission is granted for that one file
          and revoked when the installer is done with it.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

    </application>
</manifest>
